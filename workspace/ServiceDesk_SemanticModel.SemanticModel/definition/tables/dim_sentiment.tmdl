/// Customer sentiment inferred from the ticket’s message content: very_negative, negative, neutral, positive, or very_positive. Sourced directly from the ticket dataset.
table dim_sentiment
	lineageTag: 810b825a-63f5-4865-ba63-be9cfe8b01d8
	sourceLineageTag: [dbo].[dim_sentiment]

	column customer_sentiment
